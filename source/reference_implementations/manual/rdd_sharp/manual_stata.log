. do code/pilot/manual_references/rdd_sharp/manual_stata.do 

. * Manual reference for T18 (sharp RD, local-linear, triangular kernel, h=0.5)
>  — Stata.
. clear all

. set more off

. local data_path "code/pilot/data/pilot_v5_rdd.csv"

. capture confirm file "`data_path'"

. if _rc != 0 local data_path "../../data/pilot_v5_rdd.csv"

. import delimited "`data_path'", clear
(encoding automatically selected: ISO-8859-1)
(3 vars, 1,000 obs)

. 
. local h = 0.5

. gen byte inband = abs(z) < `h'

. gen double w = 1 - abs(z) / `h' if inband
(506 missing values generated)

. quietly count if inband

. local n_band = r(N)

. local n_obs = _N

. 
. quietly regress y z [aweight=w] if inband & z >= 0

. local mu_r = _b[_cons]

. quietly regress y z [aweight=w] if inband & z < 0

. local mu_l = _b[_cons]

. local late = `mu_r' - `mu_l'

. display "JSON_RESULT: " `"{"platform":"stata","late":"' %12.6f `late' `","ban
> dwidth":"' %6.4f `h' `","n_inside_band":"' `n_band' `","n_obs":"' `n_obs' `"}
> "'
