. local n_obs = e(N)

. 
. * Build the IRF set; the equation order matches Cholesky order y1 -> y2.
. tempfile irf_set

. quietly irf create var_irf, set(`irf_set', replace) step(10) order(y1 y2)

. 
. * Open the IRF result dataset and pull out the OIRF value at step 4
. * (impulse = y2, response = y1).
. preserve

. use `irf_set'.irf, clear

. quietly summarize oirf if impulse == "y2" & response == "y1" & step == 4

. local val = r(mean)

. restore

. 
. display ""


. display "Stata reference T21 (VAR(2) orth. IRF y1 ← y2, h=4):"
Stata reference T21 (VAR(2) orth. IRF y1 ← y2, h=4):

. display "  irf_y1_to_y2_h4 = " %12.6f `val'
  irf_y1_to_y2_h4 =     0.080703

. display "  lag_order      = 2"
  lag_order      = 2

. display "  identification = Cholesky, y1 ordered first"
  identification = Cholesky, y1 ordered first

. display "  n_obs          = " `n_obs'
  n_obs          = 198

. display "JSON_RESULT: " `"{"platform":"stata","irf_y1_to_y2_h4":"' %12.6f `va
> l' `","lag_order":2,"identification":"Cholesky, y1 ordered first","n_obs":"' 
> `n_obs' `"}"'
JSON_RESULT: {"platform":"stata","irf_y1_to_y2_h4":    0.080703,"lag_order":2,"
> identification":"Cholesky, y1 ordered first","n_obs":198}

. 
