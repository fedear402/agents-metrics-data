. do code/pilot/manual_references/wcb_few/manual_stata.do 

. * Manual reference for T20 (wild cluster bootstrap, 5 clusters, B=999) — Stat
> a.
. clear all

. set more off

. local data_path "code/pilot/data/pilot_v5_wcb.csv"

. capture confirm file "`data_path'"

. if _rc != 0 local data_path "../../data/pilot_v5_wcb.csv"

. import delimited "`data_path'", clear
(encoding automatically selected: ISO-8859-1)
(3 vars, 400 obs)

. 
. * Manual wild cluster bootstrap (Rademacher weights, restricted residuals).
. * This algorithm mirrors the Python and R manual references.
. set seed 20260520

. quietly regress y x, vce(cluster cluster)

. local b = _b[x]

. local se = _se[x]

. local t_obs = `b' / `se'

. 
. quietly regress y, vce(cluster cluster)

. predict double resid_r, residuals

. 
. * Discover the cluster ids actually present in the data.
. quietly levelsof cluster, local(cluster_ids)

. local extreme = 0

. local B = 999

. forvalues iter = 1/`B' {
  2.     capture drop wstar ystar
  3.     gen double wstar = .
  4.     foreach c of local cluster_ids {
  5.         local r = cond(runiformint(0, 1) == 1, 1, -1)
  6.         quietly replace wstar = `r' if cluster == `c'
  7.     }
  8.     gen double ystar = resid_r * wstar
  9.     quietly regress ystar x, vce(cluster cluster)
 10.     local t_star = _b[x] / _se[x]
 11.     if abs(`t_star') >= abs(`t_obs') local extreme = `extreme' + 1
 12. }
