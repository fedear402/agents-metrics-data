. do code/pilot/manual_references/ttest_welch/manual_stata.do 

. * Manual reference for T07 (Welch two-sample t-test) — Stata.
. clear all

. set more off

. local data_path "code/pilot/data/pilot_v5_ttest.csv"

. capture confirm file "`data_path'"

. if _rc != 0 local data_path "../../data/pilot_v5_ttest.csv"

. import delimited "`data_path'", clear
(encoding automatically selected: ISO-8859-1)
(2 vars, 200 obs)

. 
. ttest y, by(group) unequal

Two-sample t test with unequal variances
------------------------------------------------------------------------------
   Group |     Obs        Mean    Std. err.   Std. dev.   [95% conf. interval]
---------+--------------------------------------------------------------------
       0 |     100     -.03809    .0946854    .9468541   -.2259664    .1497864
       1 |     100    .5072281    .1562282    1.562282    .1972374    .8172188
---------+--------------------------------------------------------------------
Combined |     200     .234569    .0931386    1.317179    .0509037    .4182344
---------+--------------------------------------------------------------------
    diff |           -.5453182    .1826817               -.9060445   -.1845918
------------------------------------------------------------------------------
    diff = mean(0) - mean(1)                                      t =  -2.9851
H0: diff = 0                     Satterthwaite's degrees of freedom =  163.083

    Ha: diff < 0                 Ha: diff != 0                 Ha: diff > 0
 Pr(T < t) = 0.0016         Pr(|T| > |t|) = 0.0033          Pr(T > t) = 0.9984

. local t = r(t)

. local df = r(df_t)

. local p = r(p)

. quietly count if group == 0

. local n_a = r(N)

. quietly count if group == 1

. local n_b = r(N)

. * Stata signs ttest as (group 0) - (group 1); flip sign to match Python (b - 
