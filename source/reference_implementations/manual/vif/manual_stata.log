. do code/pilot/manual_references/vif/manual_stata.do 

. * Manual reference for T05 (VIF for x1..x5) — Stata.
. clear all

. set more off

. 
. local data_path "code/pilot/data/pilot_v5_collinear.csv"

. capture confirm file "`data_path'"

. if _rc != 0 local data_path "../../data/pilot_v5_collinear.csv"

. import delimited "`data_path'", clear
(encoding automatically selected: UTF-8)
(6 vars, 500 obs)

. 
. * Compute VIF_j = 1/(1-R^2_j) for each x_j regressed on the other four xs.
. local cols x1 x2 x3 x4 x5

. local n_obs = _N

. foreach c of local cols {
  2.     local others : list cols - c
  3.     quietly regress `c' `others'
  4.     local r2 = e(r2)
  5.     local vif_`c' = 1 / (1 - `r2')
  6. }

. display "JSON_RESULT: " `"{"platform":"stata","vif_x1":"' %12.6f `vif_x1' `",
> "vif_x2":"' %12.6f `vif_x2' `","vif_x3":"' %12.6f `vif_x3' `","vif_x4":"' %12
> .6f `vif_x4' `","vif_x5":"' %12.6f `vif_x5' `","n_obs":"' `n_obs' `"}"'
JSON_RESULT: {"platform":"stata","vif_x1":    3.983895,"vif_x2":    3.760068,"v
> if_x3":    1.011897,"vif_x4":    1.007178,"vif_x5":    3.178195,"n_obs":500}

. 
end of do-file
