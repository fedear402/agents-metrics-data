. do source/reference_implementations/manual/var_granger/manual_stata.do 

. * Manual reference for T22 (Granger F-test, y2 does not Granger-cause y1, 2 l
> ags) — Stata.
. clear all

. set more off

. 
. args input_dir

. if `"`input_dir'"' == "" local input_dir "tasks/var_granger"

. local data_path "`input_dir'/pilot_v4_var.csv"

. import delimited "`data_path'", clear
(encoding automatically selected: ISO-8859-1)
(3 vars, 200 obs)

. 
. tsset t

Time variable: t, 1 to 200
        Delta: 1 unit

. * Build the unrestricted and restricted OLS regressions explicitly to mirror
. * the manual Python and R scripts (same data window: t = 3..N).
. quietly regress y1 L.y1 L2.y1 L.y2 L2.y2

. local rss_unr = e(rss)

. local df_unr = e(df_r)

. local k_unr = e(rank)

. local n_used = e(N)

. quietly regress y1 L.y1 L2.y1

. local rss_res = e(rss)

. 
. local q = 2

. local F = ((`rss_res' - `rss_unr') / `q') / (`rss_unr' / `df_unr')

. local pv = Ftail(`q', `df_unr', `F')

. display ""


. display "Stata reference T22 (Granger 2-lag F):"
Stata reference T22 (Granger 2-lag F):

. display "  F            = " %12.6f `F'
  F            =     2.810101

. display "  df_num       = " `q'
  df_num       = 2

. display "  df_den       = " `df_unr'
  df_den       = 193

. display "  p_value      = " %12.6f `pv'
  p_value      =     0.062664

. display "  n_obs        = " `n_used'
  n_obs        = 198

. display "JSON_RESULT: " `"{"platform":"stata","F":"' %12.6f `F' `","df_num":"
> ' `q' `","df_den":"' `df_unr' `","p_value":"' %12.6f `pv' `","n_obs":"' `n_us
> ed' `"}"'
JSON_RESULT: {"platform":"stata","F":    2.810101,"df_num":2,"df_den":193,"p_va
> lue":    0.062664,"n_obs":198}

. 
